{
  "name": "karibase",
  "version": "2.0.0",
  "description": "Karibase - CSS Framework specialized in Admin Dashboards and Floating Bots. Complete solution for building modern admin panels with intelligent floating assistants.",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:css": "node build-css.js",
    "build:css:dev": "node build-css.js --dev",
    "build:all": "npm run build:css && npm run build",
    "lint": "eslint src --ext .vue,.js",
    "format": "prettier --write src/"
  },
  "keywords": [
    "css",
    "framework",
    "admin-dashboard",
    "admin-panel",
    "floating-bot",
    "chatbot",
    "ai-assistant",
    "dashboard",
    "saas",
    "ui",
    "components",
    "vue",
    "javascript",
    "frontend",
    "web-app"
  ],
  "author": "Karibase",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/karibase"
  },
  "bugs": {
    "url": "https://github.com/yourusername/karibase/issues"
  },
  "homepage": "https://karibase.dev",
  "files": [
    "dist/",
    "src/",
    "css/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "^4.0.6",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.5.2",
    "cssnano": "^6.1.2",
    "postcss": "^8.5.16",
    "postcss-cli": "^11.0.0",
    "vite": "^5.0.0"
  }
}
